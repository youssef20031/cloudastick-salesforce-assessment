<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>abc Warehouse User</label>
    <description>Least-privilege access for the ABC warehouse operator: read every order, move it through the delivery statuses, and correct product quantities. Read-only on catalogue and customers, no delete anywhere, no access to the application log.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <applicationVisibilities>
        <application>abc_Pharmacy_Management</application>
        <visible>true</visible>
    </applicationVisibilities>
    <objectPermissions>
        <object>Account</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Contact</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Product2</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Order</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>OrderItem</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Product2.abc_Stock_Quantity__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Product2.abc_Requires_Prescription__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Product2.abc_Category__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Order.abc_Order_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Order.abc_Delivered_Date__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Order.abc_Channel__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <tabSettings>
        <tab>abc_Warehouse_Orders</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <pageAccesses>
        <apexPage>abc_WarehouseOrders</apexPage>
        <enabled>true</enabled>
    </pageAccesses>
    <classAccesses>
        <apexClass>abc_WarehouseOrdersController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!--
        Salesforce requires ActivateOrder as a prerequisite for EditActivatedOrders.
        It does not widen what this operator can do in practice: they cannot create
        orders (allowCreate is false), so activation only ever means moving an order
        the pharmacy already took into "In delivery" and then "Delivered".
    -->
    <userPermissions>
        <name>ActivateOrder</name>
        <enabled>true</enabled>
    </userPermissions>
    <userPermissions>
        <name>EditActivatedOrders</name>
        <enabled>true</enabled>
    </userPermissions>
</PermissionSet>
